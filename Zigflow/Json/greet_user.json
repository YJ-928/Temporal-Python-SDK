{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow-json-greet-user",
    "workflowType": "greet-user",
    "version": "0.0.1"
  },
  "do": [
    {
      "greet-user": {
        "set": {
          "message": "${ \"Hello \" + {$input.name // \"Guest\"} }"
        },
        "output": {
          "as": "${ { data: .} }"
        }
      }
    }
  ]
}
