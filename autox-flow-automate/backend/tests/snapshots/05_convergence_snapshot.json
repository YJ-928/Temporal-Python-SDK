{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "convergence",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "query": "${ $input.query }"
        },
        "export": {
          "as": "${ $context + {query: .query} }"
        },
        "then": "N3_vector_search"
      }
    },
    {
      "N3_vector_search": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8000/api/v1/actions/vector_search",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "${ {q: $context.query} }"
        },
        "export": {
          "as": "${ $context + {results: .} }"
        },
        "then": "N4_rerank"
      }
    },
    {
      "N4_rerank": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8000/api/v1/actions/rerank",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "${ {data: $context.results} }"
        },
        "export": {
          "as": "${ $context + {top_result: .} }"
        },
        "then": "N5_expose"
      }
    },
    {
      "N5_expose": {
        "set": {
          "top_result": "${ $context.top_result }"
        },
        "then": "end"
      }
    }
  ]
}