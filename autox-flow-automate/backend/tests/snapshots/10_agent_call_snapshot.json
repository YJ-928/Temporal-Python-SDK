{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "agent-call",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_agent": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:11000/execute",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "${ {city: $context.city} }"
        },
        "export": {
          "as": "${ $context + {weather_result: .condition} }"
        },
        "then": "end"
      }
    }
  ]
}