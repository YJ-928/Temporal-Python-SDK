{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "routing",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_score": "${ $input.score }"
        },
        "export": {
          "as": "${ $context + {user_score: .user_score} }"
        },
        "then": "N3_if"
      }
    },
    {
      "N3_if": {
        "switch": [
          {
            "case": {
              "when": "${ $context.user_score >= 70 }",
              "then": "N4_auto_approve"
            }
          },
          {
            "default": {
              "then": "N5_auto_reject"
            }
          }
        ]
      }
    },
    {
      "N4_auto_approve": {
        "do": [
          {
            "N4_auto_approve_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8001/api/v1/actions/auto_approve",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {status: .} }"
              }
            }
          }
        ],
        "export": {
          "as": "${ . }"
        },
        "then": "N6_expose"
      }
    },
    {
      "N6_expose": {
        "set": {
          "status": "${ $context.status }"
        },
        "then": "end"
      }
    },
    {
      "N5_auto_reject": {
        "do": [
          {
            "N5_auto_reject_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8001/api/v1/actions/auto_reject",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {status: .} }"
              }
            }
          }
        ],
        "export": {
          "as": "${ . }"
        },
        "then": "N6_expose"
      }
    }
  ]
}