{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "legacy-routing",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "status": "${ $input.status }"
        },
        "export": {
          "as": "${ $context + {status: .status} }"
        },
        "then": "N3_if"
      }
    },
    {
      "N3_if": {
        "switch": [
          {
            "case": {
              "when": "${ $context.status == \"active\" }",
              "then": "N4_process"
            }
          },
          {
            "default": {
              "then": "N5_skip"
            }
          }
        ]
      }
    },
    {
      "N4_process": {
        "do": [
          {
            "N4_process_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8001/api/v1/actions/process",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {res: .} }"
              }
            }
          }
        ],
        "export": {
          "as": "${ . }"
        },
        "then": "end"
      }
    },
    {
      "N5_skip": {
        "do": [
          {
            "N5_skip_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8001/api/v1/actions/skip",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {res: .} }"
              }
            }
          }
        ],
        "export": {
          "as": "${ . }"
        },
        "then": "end"
      }
    }
  ]
}