{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "multi-action",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "item_id": "${ $input.item_id }"
        },
        "export": {
          "as": "${ $context + {item_id: .item_id} }"
        },
        "then": "N3_check_stock"
      }
    },
    {
      "N3_check_stock": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8000/api/v1/actions/check_stock",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "${ {item: $context.item_id} }"
        },
        "export": {
          "as": "${ $context + {is_available: .} }"
        },
        "then": "N4_reserve_item"
      }
    },
    {
      "N4_reserve_item": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8000/api/v1/actions/reserve_item",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "${ {item: $context.item_id} }"
        },
        "export": {
          "as": "${ $context + {reservation_id: .} }"
        },
        "then": "N5_expose"
      }
    },
    {
      "N5_expose": {
        "set": {
          "reservation_id": "${ $context.reservation_id }"
        },
        "then": "end"
      }
    }
  ]
}