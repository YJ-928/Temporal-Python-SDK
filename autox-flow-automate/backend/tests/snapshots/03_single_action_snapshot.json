{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "action-pipeline",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "id": "${ $input.user_id }"
        },
        "export": {
          "as": "${ $context + {id: .id} }"
        },
        "then": "N3_get_user"
      }
    },
    {
      "N3_get_user": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8000/api/v1/actions/get_user",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "${ {id: $context.id} }"
        },
        "export": {
          "as": "${ $context + {user_profile: .} }"
        },
        "then": "N4_expose"
      }
    },
    {
      "N4_expose": {
        "set": {
          "user_profile": "${ $context.user_profile }"
        },
        "then": "end"
      }
    }
  ]
}