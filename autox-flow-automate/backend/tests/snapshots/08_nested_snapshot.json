{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "nested",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "age": "${ $input.age }",
          "is_member": "${ $input.member }"
        },
        "export": {
          "as": "${ $context + {age: .age, is_member: .is_member} }"
        },
        "then": "N3_if"
      }
    },
    {
      "N3_if": {
        "switch": [
          {
            "case": {
              "when": "${ $context.age >= 18 }",
              "then": "N4_if"
            }
          },
          {
            "default": {
              "then": "N7_minor"
            }
          }
        ]
      }
    },
    {
      "N4_if": {
        "do": [
          {
            "N4_if_inner": {
              "switch": [
                {
                  "case": {
                    "when": "${ $context.is_member == true }",
                    "then": "N5_adult_member"
                  }
                },
                {
                  "default": {
                    "then": "N6_adult_nonmember"
                  }
                }
              ]
            }
          }
        ],
        "export": {
          "as": "${ . }"
        }
      }
    },
    {
      "N5_adult_member": {
        "do": [
          {
            "N5_adult_member_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8001/api/v1/actions/adult_member",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {res: .} }"
              }
            }
          }
        ],
        "export": {
          "as": "${ . }"
        },
        "then": "end"
      }
    },
    {
      "N6_adult_nonmember": {
        "do": [
          {
            "N6_adult_nonmember_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8001/api/v1/actions/adult_nonmember",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {res: .} }"
              }
            }
          }
        ],
        "export": {
          "as": "${ . }"
        },
        "then": "end"
      }
    },
    {
      "N7_minor": {
        "do": [
          {
            "N7_minor_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8001/api/v1/actions/minor",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {res: .} }"
              }
            }
          }
        ],
        "export": {
          "as": "${ . }"
        },
        "then": "end"
      }
    }
  ]
}