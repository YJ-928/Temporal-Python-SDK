{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "mixed",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_fetch_info": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8001/api/v1/actions/fetch_info",
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "export": {
          "as": "${ $context + {info: .} }"
        },
        "then": "N3_agent"
      }
    },
    {
      "N3_agent": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:11003/execute",
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "export": {
          "as": "${ $context + {agent_result: .} }"
        },
        "then": "end"
      }
    }
  ]
}