# FlowAutomate Backend — .env.example
#
# This file documents every supported environment variable.
# Copy it to .env and fill in the values for your environment.
# The service will not start correctly unless ALL variables below are set.

# Application
# Human-readable name shown in the root endpoint and OpenAPI docs title.
APP_NAME=FlowAutomate

# Full description shown in the OpenAPI /docs page.
APP_DESCRIPTION="FlowAutomate — AutoX Visual Workflow Automation Backend"

# Semantic version exposed in the root endpoint and OpenAPI docs.
VERSION=1.0.0

# Set to true to enable FastAPI debug mode (enables detailed error responses).
DEBUG=false

# Set to true to echo every SQL query to stdout — useful for debugging ORM issues.
DB_ECHO=false

# Logging
# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Path (relative to backend root) to the logging.conf file.
LOG_CONFIG_PATH=resources/logger.conf

# API server
# Host interface to bind the uvicorn server to. Use 0.0.0.0 to accept external traffic.
API_HOST=0.0.0.0

# Port the FastAPI backend listens on.
API_PORT=8000

# URL prefix for all v1 routes (e.g. /api/v1/workflows/...).
API_V1_PREFIX=/api/v1

# OpenAPI / Swagger docs
# Set any of these to "null" to disable the corresponding docs UI.
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# CORS
# JSON list of allowed origins. Use ["*"] in dev; restrict in production.
CORS_ORIGINS=["*"]

# Allow credentials (cookies, Authorization headers) in cross-origin requests.
CORS_CREDENTIALS=true

# Allowed HTTP methods for CORS requests.
CORS_METHODS=["*"]

# Allowed HTTP headers for CORS requests.
CORS_HEADERS=["*"]

# Temporal
# Address of the Temporal server gRPC endpoint.
TEMPORAL_ADDRESS=localhost:7233

# Seconds to wait when establishing the Temporal client connection.
TEMPORAL_CONNECT_TIMEOUT=10.0

# Seconds to wait when probing Temporal for health checks.
TEMPORAL_HEALTH_TIMEOUT=3.0

# DSL compiler defaults
# Default Zigflow DSL spec version written into compiled workflow files.
DEFAULT_DSL_VERSION=1.0.0

# Default Temporal task queue used when a workflow is compiled without an explicit queue.
DEFAULT_TASK_QUEUE=flowautomate

# Default Temporal workflow type used when compiling without an explicit type.
# Each compiled workflow derives its type from workflow_id; this is the fallback.
COMPILER_WORKFLOW_TYPE=flowautomate

# Default task queue for the Zigflow runtime worker process.
COMPILER_TASK_QUEUE=flowautomate

# Default DSL version embedded in compiled workflow documents.
COMPILER_DSL_VERSION=1.0.0

# Default workflow semantic version embedded in compiled workflow documents.
COMPILER_WORKFLOW_VERSION=1.0.0

# Zigflow runtime daemon
# Hostname where the Zigflow runtime daemon is running.
ZIGFLOW_RUNTIME_HOST=localhost

# Port the Zigflow runtime daemon health/API endpoint listens on.
ZIGFLOW_RUNTIME_PORT=3005

# Host the Zigflow Prometheus metrics endpoint binds to.
ZIGFLOW_METRICS_HOST=127.0.0.1

# Port the Zigflow Prometheus metrics endpoint listens on.
ZIGFLOW_METRICS_PORT=9095

# Seconds to wait for the Zigflow runtime health check before treating it as unhealthy.
ZIGFLOW_HEALTH_TIMEOUT=2.0

# Mock agent services
# Hostname where all mock agent services are running.
AGENT_HOST=localhost

# Port for the Weather Agent (GET /cities, POST /execute).
AGENT_WEATHER_PORT=11000

# Port for the Email Validator Agent (POST /execute).
AGENT_EMAIL_VALIDATOR_PORT=11001

# Port for the Email Sender Agent (POST /execute, GET /sent).
AGENT_EMAIL_SENDER_PORT=11002

# Port for the Summarizer Agent (POST /execute).
AGENT_SUMMARIZER_PORT=11003

# Actions API base URL
# Base URL of this backend service, used by the compiled DSL to call back to
# POST /api/v1/actions/{operation} from inside a running Zigflow workflow.
# Must be reachable from the Zigflow runtime process.
ACTIONS_BASE_URL=http://localhost:8000

# PostgreSQL connection
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=autox-flow-automate
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# PostgreSQL connection pool
# Number of persistent connections held in the pool.
DATABASE_POOL_SIZE=10

# Maximum connections above pool_size allowed under load.
DATABASE_MAX_OVERFLOW=20

# Seconds to wait for a free connection before raising an error.
DATABASE_POOL_TIMEOUT=30

# Seconds after which idle connections are recycled (avoids stale connections).
DATABASE_POOL_RECYCLE=1800
