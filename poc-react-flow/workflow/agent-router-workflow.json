{
  "document": {
    "dsl": "1.0.0",
    "namespace": "zigflow",
    "name": "agent-router",
    "version": "0.0.1"
  },
  "do": [
    {
      "captureInput": {
        "set": {
          "user_query": "${ $input.user_query }"
        }
      }
    },
    {
      "parseIntent": {
        "call": "activity",
        "with": {
          "name": "activity.execute_agent",
          "arguments": [
            "${ $data.user_query }",
            "intent"
          ],
          "taskQueue": "activity_queue"
        }
      }
    },
    {
      "saveIntent": {
        "set": {
          "intentResult": "${ $output }"
        }
      }
    },
    {
      "routeByIntent": {
        "switch": [
          {
            "hotel": {
              "when": "${ $data.intentResult.type == \"HOTEL\"}",
              "then": "runHotel"
            }
          },
          {
            "restaurant": {
              "when": "${ $data.intentResult.type == \"RESTAURANT\"}",
              "then": "runRestaurant"
            }
          },
          {
            "default": {
              "then": "setDefaultMessage"
            }
          }
        ]
      }
    },
    {
      "runHotel": {
        "do": [
          {
            "runHotelActivity": {
              "call": "activity",
              "with": {
                "name": "activity.execute_agent",
                "arguments": [
                  "${ $data.user_query }",
                  "hotel"
                ],
                "taskQueue": "activity_queue"
              }
            }
          },
          {
            "setHotelResponse": {
              "set": {
                "response": "${ $output.text }"
              }
            }
          }
        ]
      }
    },
        {
      "runRestaurant": {
        "do": [
          {
            "runRestaurantActivity": {
              "call": "activity",
              "with": {
                "name": "activity.execute_agent",
                "arguments": [
                  "${ $data.user_query }",
                  "restaurant"
                ],
                "taskQueue": "activity_queue"
              }
            }
          },
          {
            "setHotelResponse": {
              "set": {
                "response": "${ $output.text }"
              }
            }
          }
        ]
      }
    },
    {
      "setDefaultMessage": {
        "do": [
          {
            "setDefault": {
              "set": {
                "response": "I'm not able to answer your query please try another"
              }
            }
          }
        ]
      }
    }
  ]
}