{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "routing",
    "version": "1.0.0"
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_score": "${ $input.score }"
        },
        "export": {
          "as": "${ $context + {user_score: .user_score} }"
        }
      }
    },
    {
      "N3_if": {
        "switch": [
          {
            "case": {
              "when": "${ $context.user_score >= 70 }",
              "then": "N4_auto_approve"
            }
          },
          {
            "case": {
              "then": "N5_auto_reject"
            }
          }
        ]
      }
    },
    {
      "N4_auto_approve": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8000/api/v1/actions/auto_approve"
        },
        "export": {
          "as": "${ $context + {status: .} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "status": "${ $context.status }"
        },
        "then": "end"
      }
    },
    {
      "N5_auto_reject": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8000/api/v1/actions/auto_reject"
        },
        "export": {
          "as": "${ $context + {status: .} }"
        }
      }
    }
  ]
}