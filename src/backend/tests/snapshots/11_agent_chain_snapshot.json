{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "chain",
    "version": "1.0.0"
  },
  "do": [
    {
      "N2_agent": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:11001/execute",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "${ {email: $context.email} }"
        },
        "export": {
          "as": "${ $context + {validation_result: .is_valid} }"
        }
      }
    },
    {
      "N3_agent": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:11002/execute",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "${ {to: $context.email, subject: $context.subject, body: $context.body} }"
        },
        "export": {
          "as": "${ $context + {send_result: .message_id} }"
        },
        "then": "end"
      }
    }
  ]
}