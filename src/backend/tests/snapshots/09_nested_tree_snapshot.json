{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "nested-tree",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_if": {
        "switch": [
          {
            "case": {
              "when": "${ $context.a == true }",
              "then": "N3_if"
            }
          },
          {
            "default": {
              "then": "N4_if"
            }
          }
        ]
      }
    },
    {
      "N3_if": {
        "do": [
          {
            "N3_if_inner": {
              "switch": [
                {
                  "case": {
                    "when": "${ $context.b == true }",
                    "then": "N5_A_true"
                  }
                },
                {
                  "default": {
                    "then": "N6_A_false"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "N5_A_true": {
        "do": [
          {
            "N5_A_true_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8000/api/v1/actions/A_true",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {o: .} }"
              }
            }
          }
        ],
        "then": "end"
      }
    },
    {
      "N6_A_false": {
        "do": [
          {
            "N6_A_false_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8000/api/v1/actions/A_false",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {o: .} }"
              }
            }
          }
        ],
        "then": "end"
      }
    },
    {
      "N4_if": {
        "do": [
          {
            "N4_if_inner": {
              "switch": [
                {
                  "case": {
                    "when": "${ $context.c == true }",
                    "then": "N7_B_true"
                  }
                },
                {
                  "default": {
                    "then": "N8_B_false"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "N7_B_true": {
        "do": [
          {
            "N7_B_true_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8000/api/v1/actions/B_true",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {o: .} }"
              }
            }
          }
        ],
        "then": "end"
      }
    },
    {
      "N8_B_false": {
        "do": [
          {
            "N8_B_false_inner": {
              "call": "http",
              "with": {
                "method": "post",
                "endpoint": "http://localhost:8000/api/v1/actions/B_false",
                "headers": {
                  "Content-Type": "application/json"
                }
              },
              "export": {
                "as": "${ $context + {o: .} }"
              }
            }
          }
        ],
        "then": "end"
      }
    }
  ]
}