{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "default",
    "workflowType": "edge-case",
    "version": "1.0.0",
    "summary": ""
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "username": "${ $input.username }"
        },
        "export": {
          "as": "${ $context + {username: .username} }"
        },
        "then": "end"
      }
    }
  ]
}