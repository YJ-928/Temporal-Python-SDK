# Application Configuration
APP_NAME=Workflow Compiler Service
APP_DESCRIPTION=Workflow compiler service - compiles visual workflow JSON to Zigflow DSL
VERSION=1.0.0
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_CONFIG_PATH=resources/logger.conf

# DSL Compiler Defaults
DEFAULT_DSL_VERSION=1.0.0
DEFAULT_TASK_QUEUE=zigflow

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Database Configuration
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Server Configuration (for run.py)
API_HOST=0.0.0.0
API_PORT=8000
