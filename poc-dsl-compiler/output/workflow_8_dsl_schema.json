{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_id": "${ $input.user_id }"
        },
        "export": {
          "as": "${ $context + {user_id: .user_id} }"
        }
      }
    },
    {
      "N3_format_output": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/format_output",
          "body": {
            "value": "${ $context.user_id }"
          }
        },
        "output": {
          "as": {
            "formatted_output": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {formatted_output: .formatted_output} }"
        }
      }
    },
    {
      "N4_wait": {
        "listen": {
          "to": {
            "one": {
              "with": {
                "id": "payment_completed"
              }
            }
          }
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "formatted_output": "${ .formatted_output }"
        },
        "then": "end"
      }
    }
  ]
}