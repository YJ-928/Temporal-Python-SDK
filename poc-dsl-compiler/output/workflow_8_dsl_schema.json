{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "order_id": "${ $input.order_id }"
        },
        "export": {
          "as": "${ $context + {order_id: .order_id} }"
        }
      }
    },
    {
      "N3_validate_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/validate_email",
          "body": {
            "value": "${ $context.order_id }"
          }
        },
        "output": {
          "as": {
            "validation_result": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {validation_result: .validation_result} }"
        }
      }
    },
    {
      "N4_wait": {
        "listen": {
          "to": {
            "one": {
              "with": {
                "id": "notification_ack"
              }
            }
          }
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "validation_result": "${ .validation_result }"
        },
        "then": "end"
      }
    }
  ]
}