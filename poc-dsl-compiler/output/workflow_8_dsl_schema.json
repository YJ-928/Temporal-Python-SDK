{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "dob": "${ $input.date_of_birth }"
        }
      }
    },
    {
      "N3_fetch_product": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/fetch_product",
          "body": {
            "value": "${ .dob }"
          }
        },
        "output": {
          "as": {
            "product_details": "${ . }"
          }
        }
      }
    },
    {
      "N4_wait": {
        "listen": {
          "to": {
            "one": {
              "with": {
                "id": "user_confirmation"
              }
            }
          }
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "product_details": "${ .product_details }"
        }
      }
    }
  ]
}