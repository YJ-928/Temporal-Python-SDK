{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "order_id": "${ $input.order_id }"
        },
        "export": {
          "as": "${ $context + {order_id: .order_id} }"
        }
      }
    },
    {
      "N3_geocode": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/geocode",
          "body": {
            "value": "${ $context.order_id }"
          }
        },
        "output": {
          "as": {
            "coordinates": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {coordinates: .coordinates} }"
        }
      }
    },
    {
      "N4_wait": {
        "listen": {
          "to": {
            "one": {
              "with": {
                "id": "user_confirmation"
              }
            }
          }
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "coordinates": "${ .coordinates }"
        },
        "then": "end"
      }
    }
  ]
}