{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "dob": "${ $input.date_of_birth }"
        },
        "export": {
          "as": "${ $context + {dob: .dob} }"
        }
      }
    },
    {
      "N3_log_activity": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/log_activity",
          "body": {
            "value": "${ $context.dob }"
          }
        },
        "output": {
          "as": {
            "log_id": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {log_id: .log_id} }"
        }
      }
    },
    {
      "N4_wait": {
        "wait": {
          "seconds": 60
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "log_id": "${ .log_id }"
        },
        "then": "end"
      }
    }
  ]
}