{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "country": "${ $input.country }"
        },
        "export": {
          "as": "${ $context + {country: .country} }"
        }
      }
    },
    {
      "N3_send_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/send_email",
          "body": {
            "value": "${ $context.country }"
          }
        },
        "output": {
          "as": {
            "email_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {email_status: .email_status} }"
        }
      }
    },
    {
      "N4_wait": {
        "wait": {
          "minutes": 1
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "email_status": "${ .email_status }"
        },
        "then": "end"
      }
    }
  ]
}