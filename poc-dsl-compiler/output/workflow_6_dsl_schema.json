{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "order_id": "${ $input.order_id }"
        },
        "export": {
          "as": "${ $context + {order_id: .order_id} }"
        }
      }
    },
    {
      "N3_fetch_product": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/fetch_product",
          "body": {
            "value": "${ $context.order_id }"
          }
        },
        "output": {
          "as": {
            "product_details": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {product_details: .product_details} }"
        }
      }
    },
    {
      "N4_wait": {
        "wait": {
          "minutes": 5
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "product_details": "${ .product_details }"
        },
        "then": "end"
      }
    }
  ]
}