{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_email": "${ $input.email }"
        },
        "export": {
          "as": "${ $context + {user_email: .user_email} }"
        }
      }
    },
    {
      "N3_lookup_location": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/lookup_location",
          "body": {
            "value": "${ $context.user_email }"
          }
        },
        "output": {
          "as": {
            "location_data": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {location_data: .location_data} }"
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "location_data": "${ .location_data }"
        },
        "then": "end"
      }
    }
  ]
}