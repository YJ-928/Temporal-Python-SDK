{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_location": "${ $input.location }"
        }
      }
    },
    {
      "N3_enrich_profile": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/enrich_profile",
          "body": {
            "value": "${ .user_location }"
          }
        },
        "output": {
          "as": {
            "enriched_profile": "${ . }"
          }
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "enriched_profile": "${ .enriched_profile }"
        }
      }
    }
  ]
}