{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "city": "${ $input.city }"
        },
        "export": {
          "as": "${ $context + {city: .city} }"
        }
      }
    },
    {
      "N3_geocode": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/geocode",
          "body": {
            "value": "${ $context.city }"
          }
        },
        "output": {
          "as": {
            "coordinates": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {coordinates: .coordinates} }"
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "coordinates": "${ .coordinates }"
        },
        "then": "end"
      }
    }
  ]
}