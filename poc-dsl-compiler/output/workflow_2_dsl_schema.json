{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_email": "${ $input.email }",
          "order_id": "${ $input.order_id }"
        }
      }
    },
    {
      "N3_send_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/send_email",
          "body": {
            "value": "${ .user_email }"
          }
        },
        "output": {
          "as": {
            "email_status": "${ . }"
          }
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "email_status": "${ .email_status }"
        }
      }
    },
    {
      "N4_format_output": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/format_output",
          "body": {
            "value": "${ .order_id }"
          }
        },
        "output": {
          "as": {
            "formatted_output": "${ . }"
          }
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "formatted_output": "${ .formatted_output }"
        }
      }
    }
  ]
}