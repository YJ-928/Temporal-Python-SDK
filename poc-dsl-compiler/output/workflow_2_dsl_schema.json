{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "product_id": "${ $input.product_id }",
          "user_name": "${ $input.name }"
        },
        "export": {
          "as": "${ $context + {product_id: .product_id, user_name: .user_name} }"
        }
      }
    },
    {
      "N3_send_notification": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/send_notification",
          "body": {
            "value": "${ $context.product_id }"
          }
        },
        "output": {
          "as": {
            "notification_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {notification_status: .notification_status} }"
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "notification_status": "${ .notification_status }"
        },
        "then": "end"
      }
    },
    {
      "N4_generate_report": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/generate_report",
          "body": {
            "value": "${ $context.user_name }"
          }
        },
        "output": {
          "as": {
            "report": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {report: .report} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "report": "${ .report }"
        },
        "then": "end"
      }
    }
  ]
}