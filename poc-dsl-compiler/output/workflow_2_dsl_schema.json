{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_id": "${ $input.user_id }",
          "dob": "${ $input.date_of_birth }"
        },
        "export": {
          "as": "${ $context + {user_id: .user_id, dob: .dob} }"
        }
      }
    },
    {
      "N3_process_order": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/process_order",
          "body": {
            "value": "${ $context.user_id }"
          }
        },
        "output": {
          "as": {
            "order_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {order_status: .order_status} }"
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "order_status": "${ .order_status }"
        },
        "then": "end"
      }
    },
    {
      "N4_greet": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/greet",
          "body": {
            "value": "${ $context.dob }"
          }
        },
        "output": {
          "as": {
            "greeting": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {greeting: .greeting} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "greeting": "${ .greeting }"
        },
        "then": "end"
      }
    }
  ]
}