{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "phone": "${ $input.phone_number }",
          "order_id": "${ $input.order_id }"
        },
        "export": {
          "as": "${ $context + {phone: .phone, order_id: .order_id} }"
        }
      }
    },
    {
      "N3_log_activity": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/log_activity",
          "body": {
            "value": "${ $context.phone }"
          }
        },
        "output": {
          "as": {
            "log_id": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {log_id: .log_id} }"
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "log_id": "${ .log_id }"
        },
        "then": "end"
      }
    },
    {
      "N4_greet": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/greet",
          "body": {
            "value": "${ $context.order_id }"
          }
        },
        "output": {
          "as": {
            "greeting": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {greeting: .greeting} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "greeting": "${ .greeting }"
        },
        "then": "end"
      }
    }
  ]
}