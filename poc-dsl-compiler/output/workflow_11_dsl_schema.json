{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_email": "${ $input.email }"
        },
        "export": {
          "as": "${ $context + {user_email: .user_email} }"
        }
      }
    },
    {
      "N3_if": {
        "switch": [
          {
            "case": {
              "when": "${ .user_email != \"\" }",
              "then": "N12_lookup_user"
            }
          },
          {
            "default": {
              "then": "N9_log_missing_email"
            }
          }
        ]
      }
    },
    {
      "N12_lookup_user": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/lookup_user",
          "body": {
            "value": "${ $context.user_email }"
          }
        },
        "output": {
          "as": {
            "email_verified": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {email_verified: .email_verified} }"
        }
      }
    },
    {
      "N4_if": {
        "switch": [
          {
            "case": {
              "when": "${ .email_verified == true }",
              "then": "N5_send_notification"
            }
          },
          {
            "default": {
              "then": "N7_send_email"
            }
          }
        ]
      }
    },
    {
      "N5_send_notification": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/send_notification",
          "body": {
            "value": "${ $context.user_email }"
          }
        },
        "output": {
          "as": {
            "notification_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {notification_status: .notification_status} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "notification_status": "${ .notification_status }"
        },
        "then": "end"
      }
    },
    {
      "N7_send_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/send_email",
          "body": {
            "value": "${ $context.user_email }"
          }
        },
        "output": {
          "as": {
            "email_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {email_status: .email_status} }"
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "email_status": "${ .email_status }"
        },
        "then": "end"
      }
    },
    {
      "N9_log_missing_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/log_missing_email",
          "body": {
            "value": "${ $context.user_email }"
          }
        },
        "output": {
          "as": {
            "log_id": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {log_id: .log_id} }"
        }
      }
    },
    {
      "N10_expose": {
        "set": {
          "log_id": "${ .log_id }"
        },
        "then": "end"
      }
    }
  ]
}