{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_location": "${ $input.location }",
          "order_id": "${ $input.order_id }"
        },
        "export": {
          "as": "${ $context + {user_location: .user_location, order_id: .order_id} }"
        }
      }
    },
    {
      "N3_format_output": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/format_output",
          "body": {
            "value": "${ $context.user_location }"
          }
        },
        "output": {
          "as": {
            "formatted_output": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {formatted_output: .formatted_output} }"
        }
      }
    },
    {
      "N4_wait": {
        "wait": {
          "minutes": 2
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "formatted_output": "${ .formatted_output }"
        },
        "then": "end"
      }
    },
    {
      "N6_calculate_age": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/calculate_age",
          "body": {
            "value": "${ $context.order_id }"
          }
        },
        "output": {
          "as": {
            "age": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {age: .age} }"
        }
      }
    },
    {
      "N7_wait": {
        "listen": {
          "to": {
            "one": {
              "with": {
                "id": "notification_ack"
              }
            }
          }
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "age": "${ .age }"
        },
        "then": "end"
      }
    }
  ]
}