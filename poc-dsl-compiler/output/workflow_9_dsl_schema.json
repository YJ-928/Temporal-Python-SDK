{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_name": "${ $input.name }",
          "product_id": "${ $input.product_id }"
        },
        "export": {
          "as": "${ $context + {user_name: .user_name, product_id: .product_id} }"
        }
      }
    },
    {
      "N3_generate_report": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/generate_report",
          "body": {
            "value": "${ $context.user_name }"
          }
        },
        "output": {
          "as": {
            "report": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {report: .report} }"
        }
      }
    },
    {
      "N4_wait": {
        "wait": {
          "hours": 1
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "report": "${ .report }"
        },
        "then": "end"
      }
    },
    {
      "N6_calculate_age": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/calculate_age",
          "body": {
            "value": "${ $context.product_id }"
          }
        },
        "output": {
          "as": {
            "age": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {age: .age} }"
        }
      }
    },
    {
      "N7_wait": {
        "listen": {
          "to": {
            "one": {
              "with": {
                "id": "approval_received"
              }
            }
          }
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "age": "${ .age }"
        },
        "then": "end"
      }
    }
  ]
}