{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "phone": "${ $input.phone_number }",
          "user_location": "${ $input.location }"
        }
      }
    },
    {
      "N3_generate_report": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/generate_report",
          "body": {
            "value": "${ .phone }"
          }
        },
        "output": {
          "as": {
            "report": "${ . }"
          }
        }
      }
    },
    {
      "N4_wait": {
        "wait": {
          "minutes": 15
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "report": "${ .report }"
        }
      }
    },
    {
      "N6_process_order": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/process_order",
          "body": {
            "value": "${ .user_location }"
          }
        },
        "output": {
          "as": {
            "order_status": "${ . }"
          }
        }
      }
    },
    {
      "N7_wait": {
        "listen": {
          "to": {
            "one": {
              "with": {
                "id": "payment_completed"
              }
            }
          }
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "order_status": "${ .order_status }"
        }
      }
    }
  ]
}