{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "country": "${ $input.country }",
          "user_id": "${ $input.user_id }",
          "user_name": "${ $input.name }"
        },
        "export": {
          "as": "${ $context + {country: .country, user_id: .user_id, user_name: .user_name} }"
        }
      }
    },
    {
      "N3_format_output": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/format_output",
          "body": {
            "value": "${ $context.country }"
          }
        },
        "output": {
          "as": {
            "formatted_output": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {formatted_output: .formatted_output} }"
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "formatted_output": "${ .formatted_output }"
        },
        "then": "end"
      }
    },
    {
      "N5_lookup_location": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/lookup_location",
          "body": {
            "value": "${ $context.user_id }"
          }
        },
        "output": {
          "as": {
            "location_data": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {location_data: .location_data} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "location_data": "${ .location_data }"
        },
        "then": "end"
      }
    },
    {
      "N7_fetch_product": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/fetch_product",
          "body": {
            "value": "${ $context.user_name }"
          }
        },
        "output": {
          "as": {
            "product_details": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {product_details: .product_details} }"
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "product_details": "${ .product_details }"
        },
        "then": "end"
      }
    }
  ]
}