{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_email": "${ $input.email }",
          "order_id": "${ $input.order_id }",
          "user_location": "${ $input.location }"
        }
      }
    },
    {
      "N3_process_order": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/process_order",
          "body": {
            "value": "${ .user_email }"
          }
        },
        "output": {
          "as": {
            "order_status": "${ . }"
          }
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "order_status": "${ .order_status }"
        }
      }
    },
    {
      "N5_send_notification": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/send_notification",
          "body": {
            "value": "${ .order_id }"
          }
        },
        "output": {
          "as": {
            "notification_status": "${ . }"
          }
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "notification_status": "${ .notification_status }"
        }
      }
    },
    {
      "N7_verify_phone": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/verify_phone",
          "body": {
            "value": "${ .user_location }"
          }
        },
        "output": {
          "as": {
            "phone_verified": "${ . }"
          }
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "phone_verified": "${ .phone_verified }"
        }
      }
    }
  ]
}