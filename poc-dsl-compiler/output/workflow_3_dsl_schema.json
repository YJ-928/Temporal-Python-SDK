{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_location": "${ $input.location }",
          "user_id": "${ $input.user_id }",
          "user_email": "${ $input.email }"
        },
        "export": {
          "as": "${ $context + {user_location: .user_location, user_id: .user_id, user_email: .user_email} }"
        }
      }
    },
    {
      "N3_validate_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/validate_email",
          "body": {
            "value": "${ $context.user_location }"
          }
        },
        "output": {
          "as": {
            "validation_result": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {validation_result: .validation_result} }"
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "validation_result": "${ .validation_result }"
        },
        "then": "end"
      }
    },
    {
      "N5_generate_report": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/generate_report",
          "body": {
            "value": "${ $context.user_id }"
          }
        },
        "output": {
          "as": {
            "report": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {report: .report} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "report": "${ .report }"
        },
        "then": "end"
      }
    },
    {
      "N7_process_order": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/process_order",
          "body": {
            "value": "${ $context.user_email }"
          }
        },
        "output": {
          "as": {
            "order_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {order_status: .order_status} }"
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "order_status": "${ .order_status }"
        },
        "then": "end"
      }
    }
  ]
}