{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_email": "${ $input.email }",
          "user_id": "${ $input.user_id }",
          "product_id": "${ $input.product_id }"
        },
        "export": {
          "as": "${ $context + {user_email: .user_email, user_id: .user_id, product_id: .product_id} }"
        }
      }
    },
    {
      "N3_generate_report": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/generate_report",
          "body": {
            "value": "${ $context.user_email }"
          }
        },
        "output": {
          "as": {
            "report": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {report: .report} }"
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "report": "${ .report }"
        },
        "then": "end"
      }
    },
    {
      "N5_lookup_location": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/lookup_location",
          "body": {
            "value": "${ $context.user_id }"
          }
        },
        "output": {
          "as": {
            "location_data": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {location_data: .location_data} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "location_data": "${ .location_data }"
        },
        "then": "end"
      }
    },
    {
      "N7_greet": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/greet",
          "body": {
            "value": "${ $context.product_id }"
          }
        },
        "output": {
          "as": {
            "greeting": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {greeting: .greeting} }"
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "greeting": "${ .greeting }"
        },
        "then": "end"
      }
    }
  ]
}