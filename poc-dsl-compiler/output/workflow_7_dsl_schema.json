{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_id": "${ $input.user_id }",
          "city": "${ $input.city }"
        },
        "export": {
          "as": "${ $context + {user_id: .user_id, city: .city} }"
        }
      }
    },
    {
      "N3_process_order": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/process_order",
          "body": {
            "value": "${ $context.user_id }"
          }
        },
        "output": {
          "as": {
            "order_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {order_status: .order_status} }"
        }
      }
    },
    {
      "N4_wait": {
        "wait": {
          "minutes": 5
        }
      }
    },
    {
      "N5_generate_report": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/generate_report",
          "body": {
            "value": "${ $context.order_status }"
          }
        },
        "output": {
          "as": {
            "report": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {report: .report} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "report": "${ .report }"
        },
        "then": "end"
      }
    },
    {
      "N7_lookup_location": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/lookup_location",
          "body": {
            "value": "${ $context.city }"
          }
        },
        "output": {
          "as": {
            "location_data": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {location_data: .location_data} }"
        }
      }
    },
    {
      "N8_wait": {
        "wait": {
          "minutes": 5
        }
      }
    },
    {
      "N9_expose": {
        "set": {
          "location_data": "${ .location_data }"
        },
        "then": "end"
      }
    }
  ]
}