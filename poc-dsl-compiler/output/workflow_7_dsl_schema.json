{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "country": "${ $input.country }",
          "user_name": "${ $input.name }"
        },
        "export": {
          "as": "${ $context + {country: .country, user_name: .user_name} }"
        }
      }
    },
    {
      "N3_format_output": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/format_output",
          "body": {
            "value": "${ $context.country }"
          }
        },
        "output": {
          "as": {
            "formatted_output": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {formatted_output: .formatted_output} }"
        }
      }
    },
    {
      "N4_wait": {
        "wait": {
          "minutes": 15
        }
      }
    },
    {
      "N5_validate_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/validate_email",
          "body": {
            "value": "${ $context.formatted_output }"
          }
        },
        "output": {
          "as": {
            "validation_result": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {validation_result: .validation_result} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "validation_result": "${ .validation_result }"
        },
        "then": "end"
      }
    },
    {
      "N7_generate_report": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/generate_report",
          "body": {
            "value": "${ $context.user_name }"
          }
        },
        "output": {
          "as": {
            "report": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {report: .report} }"
        }
      }
    },
    {
      "N8_wait": {
        "wait": {
          "minutes": 10
        }
      }
    },
    {
      "N9_expose": {
        "set": {
          "report": "${ .report }"
        },
        "then": "end"
      }
    }
  ]
}