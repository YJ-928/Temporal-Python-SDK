{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "country": "${ $input.country }",
          "order_id": "${ $input.order_id }"
        },
        "export": {
          "as": "${ $context + {country: .country, order_id: .order_id} }"
        }
      }
    },
    {
      "N3_enrich_profile": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/enrich_profile",
          "body": {
            "value": "${ $context.country }"
          }
        },
        "output": {
          "as": {
            "enriched_profile": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {enriched_profile: .enriched_profile} }"
        }
      }
    },
    {
      "N4_wait": {
        "wait": {
          "minutes": 1
        }
      }
    },
    {
      "N5_lookup_location": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/lookup_location",
          "body": {
            "value": "${ $context.enriched_profile }"
          }
        },
        "output": {
          "as": {
            "location_data": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {location_data: .location_data} }"
        }
      }
    },
    {
      "N6_expose": {
        "set": {
          "location_data": "${ .location_data }"
        },
        "then": "end"
      }
    },
    {
      "N7_process_order": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/process_order",
          "body": {
            "value": "${ $context.order_id }"
          }
        },
        "output": {
          "as": {
            "order_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {order_status: .order_status} }"
        }
      }
    },
    {
      "N8_wait": {
        "wait": {
          "minutes": 5
        }
      }
    },
    {
      "N9_expose": {
        "set": {
          "order_status": "${ .order_status }"
        },
        "then": "end"
      }
    }
  ]
}