{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "product_id": "${ $input.product_id }"
        },
        "export": {
          "as": "${ $context + {product_id: .product_id} }"
        }
      }
    },
    {
      "N3_verify_phone": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/verify_phone",
          "body": {
            "value": "${ $context.product_id }"
          }
        },
        "output": {
          "as": {
            "phone_verified": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {phone_verified: .phone_verified} }"
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "phone_verified": "${ .phone_verified }"
        },
        "then": "end"
      }
    },
    {
      "N5_capture": {
        "set": {
          "city": "${ $input.city }"
        },
        "export": {
          "as": "${ $context + {city: .city} }"
        }
      }
    },
    {
      "N6_generate_report": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/generate_report",
          "body": {
            "value": "${ $context.city }"
          }
        },
        "output": {
          "as": {
            "report": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {report: .report} }"
        }
      }
    },
    {
      "N7_process_order": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/process_order",
          "body": {
            "value": "${ $context.report }"
          }
        },
        "output": {
          "as": {
            "order_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {order_status: .order_status} }"
        }
      }
    },
    {
      "N8_send_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/send_email",
          "body": {
            "value": "${ $context.order_status }"
          }
        },
        "output": {
          "as": {
            "email_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {email_status: .email_status} }"
        }
      }
    },
    {
      "N9_expose": {
        "set": {
          "email_status": "${ .email_status }"
        },
        "then": "end"
      }
    }
  ]
}