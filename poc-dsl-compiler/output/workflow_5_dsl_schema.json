{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_email": "${ $input.email }"
        },
        "export": {
          "as": "${ $context + {user_email: .user_email} }"
        }
      }
    },
    {
      "N3_generate_report": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/generate_report",
          "body": {
            "value": "${ $context.user_email }"
          }
        },
        "output": {
          "as": {
            "report": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {report: .report} }"
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "report": "${ .report }"
        },
        "then": "end"
      }
    },
    {
      "N5_capture": {
        "set": {
          "country": "${ $input.country }"
        },
        "export": {
          "as": "${ $context + {country: .country} }"
        }
      }
    },
    {
      "N6_geocode": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/geocode",
          "body": {
            "value": "${ $context.country }"
          }
        },
        "output": {
          "as": {
            "coordinates": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {coordinates: .coordinates} }"
        }
      }
    },
    {
      "N7_process_order": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/process_order",
          "body": {
            "value": "${ $context.coordinates }"
          }
        },
        "output": {
          "as": {
            "order_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {order_status: .order_status} }"
        }
      }
    },
    {
      "N8_format_output": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/format_output",
          "body": {
            "value": "${ $context.order_status }"
          }
        },
        "output": {
          "as": {
            "formatted_output": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {formatted_output: .formatted_output} }"
        }
      }
    },
    {
      "N9_expose": {
        "set": {
          "formatted_output": "${ .formatted_output }"
        },
        "then": "end"
      }
    }
  ]
}