{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_email": "${ $input.email }"
        }
      }
    },
    {
      "N3_verify_phone": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/verify_phone",
          "body": {
            "value": "${ .user_email }"
          }
        },
        "output": {
          "as": {
            "phone_verified": "${ . }"
          }
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "phone_verified": "${ .phone_verified }"
        }
      }
    },
    {
      "N5_capture": {
        "set": {
          "country": "${ $input.country }"
        }
      }
    },
    {
      "N6_send_notification": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/send_notification",
          "body": {
            "value": "${ .country }"
          }
        },
        "output": {
          "as": {
            "notification_status": "${ . }"
          }
        }
      }
    },
    {
      "N7_enrich_profile": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/enrich_profile",
          "body": {
            "value": "${ .notification_status }"
          }
        },
        "output": {
          "as": {
            "enriched_profile": "${ . }"
          }
        }
      }
    },
    {
      "N8_format_output": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/format_output",
          "body": {
            "value": "${ .enriched_profile }"
          }
        },
        "output": {
          "as": {
            "formatted_output": "${ . }"
          }
        }
      }
    },
    {
      "N9_expose": {
        "set": {
          "formatted_output": "${ .formatted_output }"
        }
      }
    }
  ]
}