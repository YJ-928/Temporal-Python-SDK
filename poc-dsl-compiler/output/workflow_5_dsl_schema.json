{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "city": "${ $input.city }"
        },
        "export": {
          "as": "${ $context + {city: .city} }"
        }
      }
    },
    {
      "N3_geocode": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/geocode",
          "body": {
            "value": "${ $context.city }"
          }
        },
        "output": {
          "as": {
            "coordinates": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {coordinates: .coordinates} }"
        }
      }
    },
    {
      "N4_expose": {
        "set": {
          "coordinates": "${ .coordinates }"
        },
        "then": "end"
      }
    },
    {
      "N5_capture": {
        "set": {
          "country": "${ $input.country }"
        },
        "export": {
          "as": "${ $context + {country: .country} }"
        }
      }
    },
    {
      "N6_verify_phone": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/verify_phone",
          "body": {
            "value": "${ $context.country }"
          }
        },
        "output": {
          "as": {
            "phone_verified": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {phone_verified: .phone_verified} }"
        }
      }
    },
    {
      "N7_validate_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/validate_email",
          "body": {
            "value": "${ $context.phone_verified }"
          }
        },
        "output": {
          "as": {
            "validation_result": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {validation_result: .validation_result} }"
        }
      }
    },
    {
      "N8_fetch_product": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/fetch_product",
          "body": {
            "value": "${ $context.validation_result }"
          }
        },
        "output": {
          "as": {
            "product_details": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {product_details: .product_details} }"
        }
      }
    },
    {
      "N9_expose": {
        "set": {
          "product_details": "${ .product_details }"
        },
        "then": "end"
      }
    }
  ]
}