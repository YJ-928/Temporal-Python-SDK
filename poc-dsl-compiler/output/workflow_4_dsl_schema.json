{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_location": "${ $input.location }",
          "user_id": "${ $input.user_id }"
        },
        "export": {
          "as": "${ $context + {user_location: .user_location, user_id: .user_id} }"
        }
      }
    },
    {
      "N3_greet": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/greet",
          "body": {
            "value": "${ $context.user_location }"
          }
        },
        "output": {
          "as": {
            "greeting": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {greeting: .greeting} }"
        }
      }
    },
    {
      "N4_geocode": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/geocode",
          "body": {
            "value": "${ $context.greeting }"
          }
        },
        "output": {
          "as": {
            "coordinates": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {coordinates: .coordinates} }"
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "coordinates": "${ .coordinates }"
        },
        "then": "end"
      }
    },
    {
      "N6_enrich_profile": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/enrich_profile",
          "body": {
            "value": "${ $context.user_id }"
          }
        },
        "output": {
          "as": {
            "enriched_profile": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {enriched_profile: .enriched_profile} }"
        }
      }
    },
    {
      "N7_validate_email": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/validate_email",
          "body": {
            "value": "${ $context.enriched_profile }"
          }
        },
        "output": {
          "as": {
            "validation_result": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {validation_result: .validation_result} }"
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "validation_result": "${ .validation_result }"
        },
        "then": "end"
      }
    }
  ]
}