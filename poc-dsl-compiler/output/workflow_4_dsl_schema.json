{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_email": "${ $input.email }",
          "dob": "${ $input.date_of_birth }"
        }
      }
    },
    {
      "N3_fetch_product": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/fetch_product",
          "body": {
            "value": "${ .user_email }"
          }
        },
        "output": {
          "as": {
            "product_details": "${ . }"
          }
        }
      }
    },
    {
      "N4_greet": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/greet",
          "body": {
            "value": "${ .product_details }"
          }
        },
        "output": {
          "as": {
            "greeting": "${ . }"
          }
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "greeting": "${ .greeting }"
        }
      }
    },
    {
      "N6_lookup_location": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/lookup_location",
          "body": {
            "value": "${ .dob }"
          }
        },
        "output": {
          "as": {
            "location_data": "${ . }"
          }
        }
      }
    },
    {
      "N7_verify_phone": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/verify_phone",
          "body": {
            "value": "${ .location_data }"
          }
        },
        "output": {
          "as": {
            "phone_verified": "${ . }"
          }
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "phone_verified": "${ .phone_verified }"
        }
      }
    }
  ]
}