{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow",
    "workflowType": "compiled-workflow",
    "version": "1.0.0",
    "metadata": {}
  },
  "do": [
    {
      "N2_capture": {
        "set": {
          "user_email": "${ $input.email }",
          "country": "${ $input.country }"
        },
        "export": {
          "as": "${ $context + {user_email: .user_email, country: .country} }"
        }
      }
    },
    {
      "N3_process_order": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/process_order",
          "body": {
            "value": "${ $context.user_email }"
          }
        },
        "output": {
          "as": {
            "order_status": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {order_status: .order_status} }"
        }
      }
    },
    {
      "N4_greet": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/greet",
          "body": {
            "value": "${ $context.order_status }"
          }
        },
        "output": {
          "as": {
            "greeting": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {greeting: .greeting} }"
        }
      }
    },
    {
      "N5_expose": {
        "set": {
          "greeting": "${ .greeting }"
        },
        "then": "end"
      }
    },
    {
      "N6_format_output": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/format_output",
          "body": {
            "value": "${ $context.country }"
          }
        },
        "output": {
          "as": {
            "formatted_output": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {formatted_output: .formatted_output} }"
        }
      }
    },
    {
      "N7_geocode": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://localhost:8080/geocode",
          "body": {
            "value": "${ $context.formatted_output }"
          }
        },
        "output": {
          "as": {
            "coordinates": "${ . }"
          }
        },
        "export": {
          "as": "${ $context + {coordinates: .coordinates} }"
        }
      }
    },
    {
      "N8_expose": {
        "set": {
          "coordinates": "${ .coordinates }"
        },
        "then": "end"
      }
    }
  ]
}