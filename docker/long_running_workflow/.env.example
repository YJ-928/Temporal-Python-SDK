# Zigflow Execution Orchestrator — Environment Configuration
# Copy to .env and edit before running locally or in Docker.

# Temporal
# For local dev: localhost:7233
# For Docker:    temporal:7233  (Docker service name)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=orchestrator-queue

# FastAPI
ORCHESTRATOR_API_URL=http://localhost:8000

# Workflow storage
# Absolute path to the workflows/json directory (mounted into containers)
WORKFLOWS_DIR=/absolute/path/to/Docker/long_running_workflow/workflows/json

# Docker execution
RUNNER_IMAGE=zigflow-runner:latest
# Docker network that both orchestrator and runners join
DOCKER_NETWORK=temporal-network
# Temporal address visible from inside runner containers
DOCKER_TEMPORAL_HOST=temporal:7233

# Execution limits
EXECUTION_TIMEOUT_SECONDS=3600

# Logging
LOG_LEVEL=INFO
