{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow-greet-upper",
    "version": "0.0.1",
    "workflowType": "uppercase-greeting"
  },
  "do": [
    {
      "greetUserUpper": {
        "set": {
          "message": "${ \"Hello \" + (($input.name // \"UpperGuest\") | ascii_upcase) }"
        },
        "output": {
          "as": {
            "data": "${ . }"
          }
        }
      }
    }
  ]
}