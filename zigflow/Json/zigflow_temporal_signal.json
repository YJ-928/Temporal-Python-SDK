{
  "document": {
    "dsl": "1.0.0",
    "taskQueue": "zigflow-temporal-signals",
    "version": "0.0.1",
    "workflowType": "listen-to-signal"
  },
  "do": [
    {
      "temporalListener": {
        "metadata": {
          "timeout": "1h"
        },
        "listen": {
          "to": {
            "one": {
              "with": {
                "id": "approve",
                "type": "signal"
              }
            }
          }
        }
      }
    },
    {
      "outputSignal": {
        "set": {
          "signal": "${ $data.temporalListener }"
        },
        "output": {
          "as": "${ $context + { response: $data.temporalListener } }"
        }
      }
    }
  ]
}